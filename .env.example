# Any OpenAI-compatible provider works. Defaults target the Gemini API free tier
# (create a key at https://aistudio.google.com/apikey).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Chat model with tool calling (chosen in phase 0, see docs/decisions.md D6)
LLM_MODEL=gemini-3.5-flash-lite
# Embedding model for policy retrieval, served by the same provider
EMBEDDING_MODEL=gemini-embedding-001
# Chat requests per minute the client allows itself (free tier: 15). 0 disables pacing.
LLM_MAX_RPM=12
