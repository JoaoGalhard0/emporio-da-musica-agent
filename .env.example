# Any OpenAI-compatible provider works. Defaults target the Gemini API free tier
# (create a key at https://aistudio.google.com/apikey).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Chat model with tool calling; chosen in phase 0 from the models the key can access
LLM_MODEL=
# Embedding model for policy retrieval, served by the same provider
EMBEDDING_MODEL=
